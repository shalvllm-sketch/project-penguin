# Copy to .env.local for local dev. Add the same vars in Vercel > Project > Settings > Environment Variables.

# From Supabase: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# From Supabase: Project Settings > API Keys > service_role / secret key (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Per-person passwords. Whichever password is entered decides who's chatting.
PASSWORD_ME=Pookie
PASSWORD_DIYA=Peanut

# Web Push (VAPID) keys — generate with: npx web-push generate-vapid-keys
# The PUBLIC key must be prefixed with NEXT_PUBLIC_ so the browser can read it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push service (use your email)
VAPID_SUBJECT=mailto:you@example.com
